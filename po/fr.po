#: data/io.github.swordpuffin.rewaita.desktop.in:2
#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:7
msgid "Rewaita"
msgstr "Rewaita"

#: data/io.github.swordpuffin.rewaita.desktop.in:8
msgid "gtk;adwaita;gnome;shell;theme"
msgstr "gtk;adwaita;gnome;shell;theme"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:8
msgid "Bring color to Adwaita"
msgstr "Apportez de la couleur à Adwaita"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:10
msgid ""
"Rewaita gives your Adwaita apps a fresh look by colorizing them with popular "
"theme's palettes."
msgstr ""
"Rewaita donne un nouvel aspect à vos applications Adwaita en les"
"colorisant avec les palettes de thèmes populaires."

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:11
msgid "Features:"
msgstr "Fonctionnalités :"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:13
msgid "Modify application window controls"
msgstr "Modifier les contrôles de fenêtre des applications"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:14
msgid "Make custom themes"
msgstr "Créer des thèmes personnalisés"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:15
msgid "Palette swap/tint wallpapers"
msgstr "Échanger/teinter les fonds d'écran avec des palettes"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:16
msgid "Add effects like transparency, window borders, or sharp corners"
msgstr ""
"Ajouter des effets comme la transparence, les bordures de fenêtre ou"
"les coins carrés"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:18
msgid ""
"Changes only affect GTK3/4 applications; other UI toolkits are not affected"
msgstr ""
"Les modifications n'affectent que les applications GTK3/4 ; les autres"
"boîtes à outils d'interface ne sont pas affectées"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:22
msgid "Nathan Perlman"
msgstr "Nathan Perlman"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:51
msgid "Browsing through dark themes"
msgstr "Parcourir les thèmes sombres"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:55
msgid "Browsing through light themes"
msgstr "Parcourir les thèmes clairs"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:59
msgid "Making a custom theme"
msgstr "Créer un thème personnalisé"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:63
msgid "Changing the window control scheme"
msgstr "Modifier le schéma des contrôles de fenêtre"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:67
msgid "Palette swapping dialog for wallpapers"
msgstr "Dialogue d'échange de palette pour les fonds d'écran"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:71
msgid "Browsing extra customization options"
msgstr "Parcourir les options de personnalisation supplémentaires"

#: data/io.github.swordpuffin.rewaita.metainfo.xml.in:159
msgid "See v1.1.0"
msgstr "Voir v1.1.0"

